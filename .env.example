###############################################################################
#                                                                             #
#   PostgreSQL Container Backup Demo                                          #
#   https://github.com/bauer-group/DEMO-ContainerBackupPostgreSQL             #
#                                                                             #
###############################################################################

###############################################################################
# STACK
###############################################################################

STACK_NAME=pgbackup_demo
TZ=Etc/UTC

###############################################################################
# POSTGRESQL
###############################################################################

POSTGRES_VERSION=16
POSTGRES_USER=demoapp
POSTGRES_PASSWORD=CHANGE_ME_generate_with_openssl_rand_base64_24
POSTGRES_DB=demodb

###############################################################################
# S3 STORAGE
###############################################################################
#
# Unterstützte Backends:
#
#   ┌────────────────────┬─────────────────────────────────────────────────────┐
#   │ Provider           │ S3_ENDPOINT                                         │
#   ├────────────────────┼─────────────────────────────────────────────────────┤
#   │ Lokale MinIO       │ http://minio:9000                                   │
#   │ Externe MinIO      │ https://minio.example.com                           │
#   │ AWS S3             │ https://s3.amazonaws.com                            │
#   │ AWS S3 (Region)    │ https://s3.eu-central-1.amazonaws.com               │
#   │ DigitalOcean       │ https://fra1.digitaloceanspaces.com                 │
#   │ Wasabi             │ https://s3.eu-central-1.wasabisys.com               │
#   │ Cloudflare R2      │ https://<account>.r2.cloudflarestorage.com          │
#   │ Backblaze B2       │ https://s3.us-west-000.backblazeb2.com              │
#   └────────────────────┴─────────────────────────────────────────────────────┘
#
###############################################################################

S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_base64_32
S3_BUCKET=pg-backups
#S3_REGION=eu-central-1

###############################################################################
# S3 SICHERHEIT (WORM)
###############################################################################
#
# Immutable Backup-Strategie mit Object Lock (WORM):
#
#   ┌─────────────────────────────────────────────────────────────────────────┐
#   │  Client                          S3 Bucket (Object Lock)                │
#   │  ┌───────────────┐              ┌───────────────────┐                   │
#   │  │ ✅ PutObject  │─────────────▶│ WORM: 30 Tage     │                   │
#   │  │ ✅ GetObject  │              │                   │                   │
#   │  │ ✅ Delete*    │──────X──────▶│ ❌ Blocked        │                   │
#   │  │ ❌ BypassWORM │              │ Lifecycle: 31d    │                   │
#   │  └───────────────┘              └───────────────────┘                   │
#   │                                                                         │
#   │  * Delete erlaubt, aber Object Lock blockiert während Retention         │
#   │  * Schutz kommt vom WORM, nicht von IAM-Restriktionen                   │
#   │  * Kritisch: s3:BypassGovernanceRetention NICHT vergeben!               │
#   └─────────────────────────────────────────────────────────────────────────┘
#
# Externe S3 einrichten: siehe docs/EXTERNAL_S3_SETUP.md
#
###############################################################################

###############################################################################
# MINIO LOCAL (nur für Demo)
###############################################################################

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

###############################################################################
# BACKUP SCHEDULE
###############################################################################
#
#   ┌─────────────────────┬─────────────────────────────────────────────────────┐
#   │ Expression          │ Beschreibung                                        │
#   ├─────────────────────┼─────────────────────────────────────────────────────┤
#   │ @hourly             │ Jede Stunde                                         │
#   │ @daily              │ Täglich 00:00 UTC                                   │
#   │ 0 3 * * *           │ Täglich 03:00 UTC                                   │
#   │ */15 * * * *        │ Alle 15 Minuten                                     │
#   │ 0 */4 * * *         │ Alle 4 Stunden                                      │
#   └─────────────────────┴─────────────────────────────────────────────────────┘
#
###############################################################################

# Demo: alle 5 Minuten | Produktion: @hourly oder 0 3 * * *
BACKUP_SCHEDULE=*/5 * * * *
BACKUP_EXTRA_OPTS=-Z6 --blobs

###############################################################################
# RETENTION
###############################################################################
#
#   Speicherbedarf bei 100 MB/Backup:
#   Daily (7) + Weekly (4) + Monthly (6) = 17 × 100 MB ≈ 1.7 GB
#
###############################################################################

BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=6

###############################################################################
# S3 SYNC
###############################################################################
#
# S3_PREFIX ermöglicht mehrere Stacks im gleichen Bucket:
#
#   ┌─────────────────────────────────────────────────────────────────────────┐
#   │  Ohne Prefix:        s3://pg-backups/daily/db-2025.sql.gz               │
#   │  Mit Prefix:         s3://pg-backups/production/daily/db-2025.sql.gz    │
#   │                                       └─────────┘                       │
#   │                                         S3_PREFIX                       │
#   └─────────────────────────────────────────────────────────────────────────┘
#
#   Empfehlung: STACK_NAME als Prefix verwenden für Multi-Tenant Setups
#
###############################################################################

# Demo: 300s (5 Min) | Produktion: 3600 (1h)
SYNC_INTERVAL=300

# Optional: Prefix für S3 Pfad (z.B. Stack-Name für Multi-Tenant)
#S3_PREFIX=production

###############################################################################
# WORM RETENTION (pro Backup-Typ)
###############################################################################
#
# Granulares WORM-Konzept: Unterschiedliche Retention pro Backup-Typ
#
#   ┌──────────┬───────────────────┬─────────────┬─────────────────────────┐
#   │ Prefix   │ Lokale Retention  │ S3 WORM     │ S3 Lifecycle            │
#   ├──────────┼───────────────────┼─────────────┼─────────────────────────┤
#   │ last/    │ stündlich         │ kein WORM   │ 2 Tage (auto-delete)    │
#   │ daily/   │ 7 Tage            │ 14 Tage     │ 15 Tage (auto-delete)   │
#   │ weekly/  │ 4 Wochen (28d)    │ 35 Tage     │ 36 Tage (auto-delete)   │
#   │ monthly/ │ 6 Monate (180d)   │ 185 Tage    │ 186 Tage (auto-delete)  │
#   └──────────┴───────────────────┴─────────────┴─────────────────────────┘
#
# Die WORM-Retention wird beim Upload per Object gesetzt.
# Lifecycle löscht automatisch nach Ablauf der WORM-Retention.
#
###############################################################################

# WORM-Retention in Tagen (pro Backup-Typ)
RETENTION_DAILY=14
RETENTION_WEEKLY=35
RETENTION_MONTHLY=185

###############################################################################
# OBJECT LOCK & LIFECYCLE
###############################################################################
#
# Lokale MinIO (Demo):
#   - Object Lock: Automatisch via minio-init
#   - Per-Object WORM: Beim Sync gesetzt
#   - Lifecycle: Prefix-basiert (daily/weekly/monthly)
#
# Externe S3 (Produktion):
#   1. Bucket mit Object Lock erstellen (bei Erstellung!)
#   2. Per-Object Retention beim Upload (siehe backup-sync)
#   3. Lifecycle Rules pro Prefix konfigurieren
#   4. IAM OHNE s3:BypassGovernanceRetention
#
#   Vollständige Anleitung: docs/EXTERNAL_S3_SETUP.md
#
###############################################################################

###############################################################################
# QUICK START
###############################################################################
#
#   # Lokale Demo (mit MinIO)
#   cp .env.example .env && docker compose up -d
#
#   # Mit externer S3
#   docker compose up -d postgres backup backup-sync
#
#   # MinIO Console: http://localhost:9001
#
###############################################################################
